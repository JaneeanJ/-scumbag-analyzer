# Claude API（必填）
ANTHROPIC_API_KEY=
# 供应商端点：留空则用 Anthropic 官方；DeepSeek 填 https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=
# 模型名：DeepSeek 用 deepseek-chat（纯文本输出且支持图片）
ANTHROPIC_MODEL=deepseek-chat
# MongoDB（必填）
# 本地开发: mongodb://localhost:27017/scumbag-analyzer
# Atlas 生产: mongodb+srv://user:pass@cluster.mongodb.net/scumbag-analyzer
MONGODB_URI=mongodb://localhost:27017/scumbag-analyzer

# 服务器
PORT=3001
NODE_ENV=development

# 前端域名（生产环境填 Vercel 的域名，多个用逗号分隔）
# 示例: https://your-app.vercel.app,https://your-custom-domain.com
FRONTEND_ORIGINS=http://localhost:5173
